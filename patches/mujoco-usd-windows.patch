+  light->type = mjLIGHT_SPOT;
+  light->cutoff = 45.0;
+  light->exponent = 1.0;
+}
+
+void ParseUsdDistantLight(
+    mjSpec* spec,
+    const pxr::UsdPrim& prim,
+    pxr::UsdGeomXformCache& xform_cache) {
+  printf("USD DECODER: DISTANT LIGHT FOUND: %s\n",
+         prim.GetPath().GetAsString().c_str());
+
+  mjsLight* light =
+      mjs_addLight(mjs_findBody(spec, "world"), nullptr);
+
+  InitializeUsdLight(light, prim);
+  SetUsdLightPose(prim, xform_cache, light);
+
+  light->type = mjLIGHT_DIRECTIONAL;
+  light->intensity = GetUsdLightIntensity(prim);
+}
+
+void ParseUsdDomeLight(
+    mjSpec* spec,
+    pxr::UsdStageRefPtr stage,
+    const pxr::UsdPrim& prim,
+    pxr::UsdGeomXformCache& xform_cache) {
+  printf("USD DECODER: DOME LIGHT FOUND: %s\n",
+         prim.GetPath().GetAsString().c_str());
+
+  pxr::UsdAttribute texture_attr =
+      prim.GetAttribute(pxr::TfToken("inputs:texture:file"));
+
+  pxr::SdfAssetPath asset_path;
+  if (!texture_attr.Get(&asset_path) || asset_path.GetAssetPath().empty()) {
+    printf("USD DECODER: DOME LIGHT has no texture; skipping.\n");
+    return;
+  }
+
+  std::string texture_path =
+    stage->GetRootLayer()->ComputeAbsolutePath(
+        asset_path.GetAssetPath());
+
+  printf("USD DECODER: DOME TEXTURE = %s\n",
+         texture_path.c_str());
+
+  mjsTexture* texture = mjs_addTexture(spec);
+
+  const std::string texture_name = "usd_dome_environment";
+
+  mjs_setName(texture->element, texture_name.c_str());
+  mjs_setString(texture->file, texture_path.c_str());
+  mjs_setString(texture->content_type, "image/ktx");
+
+  // The Filament image-light path expects an image texture.
+  texture->type = mjTEXTURE_2D;
+
+  mjsLight* light =
+      mjs_addLight(mjs_findBody(spec, "world"), nullptr);
+
+  InitializeUsdLight(light, prim);
+  SetUsdLightPose(prim, xform_cache, light);
+
+  light->type = mjLIGHT_IMAGE;
+  mjs_setString(light->texture, texture_name.c_str());
+
+  printf("USD DECODER: DOME LIGHT MUJOCO INTENSITY = %.6f\n",
+         light->intensity);
+}
+
+void ParseUsdLight(
+    mjSpec* spec,
+    pxr::UsdStageRefPtr stage,
+    const pxr::UsdPrim& prim,
+    pxr::UsdGeomXformCache& xform_cache) {
+  pxr::TfToken type = prim.GetTypeName();
+
+  if (type == pxr::TfToken("RectLight")) {
+    ParseUsdRectLight(spec, prim, xform_cache);
+  } else if (type == pxr::TfToken("SphereLight")) {
+    ParseUsdSphereLight(spec, prim, xform_cache);
+  } else if (type == pxr::TfToken("DiskLight")) {
+    ParseUsdDiskLight(spec, prim, xform_cache);
+  } else if (type == pxr::TfToken("CylinderLight")) {
+    ParseUsdCylinderLight(spec, prim, xform_cache);
+  } else if (type == pxr::TfToken("DistantLight")) {
+    ParseUsdDistantLight(spec, prim, xform_cache);
+  } else if (type == pxr::TfToken("DomeLight")) {
+    ParseUsdDomeLight(spec, stage, prim, xform_cache);
+  }
+}
