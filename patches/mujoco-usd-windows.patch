+void ParseMaterialXSurface(mjSpec* spec, mjsMaterial* material,
+                           const pxr::UsdShadeShader& shader) {
+  // Blender's MaterialX Principled shader uses base_color for RGB.
+  auto diffuse = ReadShaderInput<pxr::GfVec3f>(
+      spec, shader.GetInput(kTokens->base_color));
+  AssignShaderInput(spec, material, &material->rgba, mjTEXROLE_RGB, diffuse);
+
+  // Unlike the RGB color, opacity is a separate scalar input.
+  auto opacity = ReadShaderInput<float>(
+      spec, shader.GetInput(kTokens->geometry_opacity));
+  if (opacity.value.has_value()) {
+    material->rgba[3] = opacity.value.value();
+  }
+
+  auto roughness = ReadShaderInput<float>(
+      spec, shader.GetInput(kTokens->specular_roughness));
+  AssignShaderInput(spec, material, &material->roughness,
+                    mjTEXROLE_ROUGHNESS, roughness);
+}
