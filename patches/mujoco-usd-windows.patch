+void ParseUsdCamera(pxr::UsdStageRefPtr stage, mjSpec* spec,
+                    const pxr::UsdPrim& prim,
+                    pxr::UsdGeomXformCache& xform_cache) {
+  pxr::UsdGeomCamera usd_camera(prim);
+
+  printf("USD DECODER: CAMERA FOUND: %s\n",
+       prim.GetPath().GetAsString().c_str());
+
+  mjsCamera* camera = mjs_addCamera(mjs_findBody(spec, "world"), nullptr);
+
+  mjs_setName(camera->element, prim.GetPath().GetAsString().c_str());
+  SetUsdPrimPathUserValue(camera->element, prim.GetPath());
+
+  // The USD camera is attached to the world, so use the stage pseudo-root
+  // as its parent when converting its transform.
+  SetLocalPoseFromPrim(
+      prim, stage->GetPseudoRoot(), camera, xform_cache);
+
+  // USD camera projection.
+  pxr::TfToken projection;
+  if (usd_camera.GetProjectionAttr().Get(&projection) &&
+      projection == pxr::TfToken("orthographic")) {
+    camera->proj = mjPROJ_ORTHOGRAPHIC;
+  } else {
+    camera->proj = mjPROJ_PERSPECTIVE;
+  }
+
+  // Convert USD vertical aperture and focal length to MuJoCo vertical FOV.
+  double focal_length = 0.0;
+  double vertical_aperture = 0.0;
+
+  if (usd_camera.GetFocalLengthAttr().Get(&focal_length) &&
+      usd_camera.GetVerticalApertureAttr().Get(&vertical_aperture) &&
+      focal_length > 0.0) {
+    camera->fovy =
+        2.0 * std::atan(vertical_aperture / (2.0 * focal_length)) *
+        180.0 / std::numbers::pi;
+  }
+}
+
+void ParseUsdRectLight(
+    mjSpec* spec,
+    const pxr::UsdPrim& prim,
+    pxr::UsdGeomXformCache& xform_cache) {
+  pxr::UsdLuxRectLight usd_light(prim);
+
+  printf("USD DECODER: RECT LIGHT FOUND: %s\n",
+         prim.GetPath().GetAsString().c_str());
+
+  mjsLight* light = mjs_addLight(mjs_findBody(spec, "world"), nullptr);
+
+  mjs_setName(light->element, prim.GetPath().GetAsString().c_str());
+  SetUsdPrimPathUserValue(light->element, prim.GetPath());
+
+  // The USD RectLight is attached to the world, so use its world
+  // transform directly. MuJoCo lights use position + direction
+  // rather than a position + quaternion pose.
+  pxr::GfMatrix4d xform =
+      xform_cache.GetLocalToWorldTransform(prim);
+
+  pxr::GfVec3d position = xform.ExtractTranslation();
+
+  light->pos[0] = position[0];
+  light->pos[1] = position[1];
+  light->pos[2] = position[2];
+
+  pxr::GfMatrix3d rotation = xform.ExtractRotationMatrix();
+
+  pxr::GfVec3d direction(
+      -rotation[2][0],
+      -rotation[2][1],
+      -rotation[2][2]);
+
+  direction.Normalize();
+
+  light->dir[0] = direction[0];
+  light->dir[1] = direction[1];
+  light->dir[2] = direction[2];
+
+  // MuJoCo spot light.
+  light->type = mjLIGHT_DIRECTIONAL;
+  light->active = 1;
+  light->castshadow = 1;
+
+  // USD light color.
+  pxr::GfVec3f color(1.0f, 1.0f, 1.0f);
+  usd_light.GetColorAttr().Get(&color);
+
+  light->diffuse[0] = color[0];
+  light->diffuse[1] = color[1];
+  light->diffuse[2] = color[2];
+
+  light->specular[0] = color[0];
+  light->specular[1] = color[1];
+  light->specular[2] = color[2];
+
+  // USD intensity is not directly expressed in MuJoCo light units.
+  // Start with the authored value as a visual approximation.
+  float intensity = 0.0f;
+  pxr::UsdAttribute intensity_attr =
+      prim.GetAttribute(pxr::TfToken("inputs:intensity"));
+
+  if (intensity_attr.Get(&intensity)) {
+    light->intensity = intensity;
+  }
+
+  printf("USD DECODER: LIGHT INTENSITY = %.6f\n",
+         static_cast<double>(intensity));
+  // Use the larger RectLight dimension to determine a reasonable
+  // starting spotlight cone.
+  double width = 0.0;
+  double height = 0.0;
+
+  usd_light.GetWidthAttr().Get(&width);
+  usd_light.GetHeightAttr().Get(&height);
+
+  double size = std::max(width, height);
+
+  if (size > 0.0) {
+    // Approximate the angular extent of the rectangular emitter.
+    // The exact distance-dependent USD area-light behavior cannot be
+    // represented by a single MuJoCo spot light.
+    light->cutoff = 45.0;
+  }
+
+  light->exponent = 1.0;
+
+  printf(
+    "USD DECODER: FINAL RECT LIGHT "
+    "type=%d active=%d shadow=%d "
+    "pos=(%.3f, %.3f, %.3f) "
+    "dir=(%.3f, %.3f, %.3f) "
+    "intensity=%.3f "
+    "cutoff=%.3f softness=%.3f exponent=%.3f\n",
+    light->type,
+    light->active,
+    light->castshadow,
+    light->pos[0],
+    light->pos[1],
+    light->pos[2],
+    light->dir[0],
+    light->dir[1],
+    light->dir[2],
+    light->intensity,
+    light->cutoff,
+    light->softness,
+    light->exponent);
+
+}
+
+double GetUsdLightIntensity(const pxr::UsdPrim& prim) {
+  float value = 0.0f;
+
+  pxr::UsdAttribute attr =
+      prim.GetAttribute(pxr::TfToken("inputs:intensity"));
+
+  if (attr.Get(&value)) {
+    return static_cast<double>(value);
+  }
+
+  return 0.0;
+}
+
+double GetUsdLightExposure(const pxr::UsdPrim& prim) {
+  float value = 0.0f;
+
+  pxr::UsdAttribute attr =
+      prim.GetAttribute(pxr::TfToken("inputs:exposure"));
+
+  if (attr.Get(&value)) {
+    return static_cast<double>(value);
+  }
+
+  return 0.0;
+}
+
+pxr::GfVec3f GetUsdLightColor(const pxr::UsdPrim& prim) {
+  pxr::GfVec3f color(1.0f, 1.0f, 1.0f);
+
+  pxr::UsdAttribute attr =
+      prim.GetAttribute(pxr::TfToken("inputs:color"));
+
+  attr.Get(&color);
+
+  return color;
+}
+
+void InitializeUsdLight(mjsLight* light, const pxr::UsdPrim& prim) {
+  mjs_setName(light->element, prim.GetPath().GetAsString().c_str());
+  SetUsdPrimPathUserValue(light->element, prim.GetPath());
+
+  light->active = 1;
+  light->castshadow = 1;
+
+  pxr::GfVec3f color = GetUsdLightColor(prim);
+
+  light->diffuse[0] = color[0];
+  light->diffuse[1] = color[1];
+  light->diffuse[2] = color[2];
+
+  light->specular[0] = color[0];
+  light->specular[1] = color[1];
+  light->specular[2] = color[2];
+
+  double intensity = GetUsdLightIntensity(prim);
+  double exposure = GetUsdLightExposure(prim);
+
+  light->intensity = intensity * std::pow(2.0, exposure);
+
+}
+
+void SetUsdLightPose(const pxr::UsdPrim& prim,
+                     pxr::UsdGeomXformCache& xform_cache,
+                     mjsLight* light) {
+  pxr::GfMatrix4d xform =
+      xform_cache.GetLocalToWorldTransform(prim);
+
+  pxr::GfVec3d position = xform.ExtractTranslation();
+
+  light->pos[0] = position[0];
+  light->pos[1] = position[1];
+  light->pos[2] = position[2];
+
+  pxr::GfMatrix3d rotation = xform.ExtractRotationMatrix();
+
+  // USD lights emit along their local -Z axis.
+  pxr::GfVec3d direction(
+      -rotation[2][0],
+      -rotation[2][1],
+      -rotation[2][2]);
+
+  direction.Normalize();
+
+  light->dir[0] = direction[0];
+  light->dir[1] = direction[1];
+  light->dir[2] = direction[2];
+
+}
+
+void ParseUsdSphereLight(
+    mjSpec* spec,
+    const pxr::UsdPrim& prim,
+    pxr::UsdGeomXformCache& xform_cache) {
+  printf("USD DECODER: SPHERE LIGHT FOUND: %s\n",
+         prim.GetPath().GetAsString().c_str());
+
+  printf(
+    "USD DECODER: LIGHT ENUMS "
+    "POINT=%d SPOT=%d DIRECTIONAL=%d\n",
+    mjLIGHT_POINT,
+    mjLIGHT_SPOT,
+    mjLIGHT_DIRECTIONAL);
+
+  mjsLight* light =
+      mjs_addLight(mjs_findBody(spec, "world"), nullptr);
+
+  InitializeUsdLight(light, prim);
+  SetUsdLightPose(prim, xform_cache, light);
+
+  pxr::UsdLuxShapingAPI shaping(prim);
+
+  float cone_angle = 0.0f;
+
+  if (shaping.GetShapingConeAngleAttr().Get(&cone_angle)) {
+    printf("USD DECODER: SPHERE LIGHT HAS SHAPING CONE: %.3f degrees\n",
+           cone_angle);
+
+  light->type = mjLIGHT_SPOT;
+  light->cutoff = cone_angle;
+
+  float cone_softness = 0.0f;
+  if (shaping.GetShapingConeSoftnessAttr().Get(&cone_softness)) {
+    light->softness = cone_softness;
+  }
+  } else {
+    light->type = mjLIGHT_POINT;
+  }
+
+  printf("USD DECODER: SPHERE LIGHT MUJOCO INTENSITY = %.6f\n",
+         light->intensity);
+
+  printf(
+    "USD DECODER: FINAL SPHERE LIGHT "
+    "type=%d active=%d shadow=%d "
+    "pos=(%.3f, %.3f, %.3f) "
+    "dir=(%.3f, %.3f, %.3f) "
+    "intensity=%.3f "
+    "cutoff=%.3f softness=%.3f exponent=%.3f\n",
+    light->type,
+    light->active,
+    light->castshadow,
+    light->pos[0],
+    light->pos[1],
+    light->pos[2],
+    light->dir[0],
+    light->dir[1],
+    light->dir[2],
+    light->intensity,
+    light->cutoff,
+    light->softness,
+    light->exponent);
+
+}
